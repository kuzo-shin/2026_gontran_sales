        // Update Top KPI Cards
        function updateKPICards() {
            const metricLabels = { total: '합계금액', supply: '공급가액', vat: '부가세액' };
            const label = metricLabels[currentMetric];
            const maxM = MONTHLY_DATA.length > 0 ? MONTHLY_DATA[MONTHLY_DATA.length - 1].month_num : 10;

            const grandVal = TOTALS['grand_' + currentMetric];
            const barogaVal = TOTALS['baroga_' + currentMetric];
            const deodareunVal = TOTALS['deodareun_' + currentMetric];

            const elKpi1Title = document.getElementById('kpi1-title');
            const elKpi1Badge = document.getElementById('kpi1-badge');
            const elKpi1Val = document.getElementById('kpi1-value');
            const elKpi1Sup = document.getElementById('kpi1-supply-sub');
            const elKpi1Vat = document.getElementById('kpi1-vat-sub');
            if (elKpi1Title) elKpi1Title.textContent = `1~${maxM}월 누적 매입 (${label})`;
            if (elKpi1Badge) elKpi1Badge.textContent = `${label} 기준`;
            if (elKpi1Val) elKpi1Val.textContent = fmtNum(grandVal) + '원';
            if (elKpi1Sup) elKpi1Sup.textContent = fmtNum(TOTALS.grand_supply) + '원';
            if (elKpi1Vat) elKpi1Vat.textContent = fmtNum(TOTALS.grand_vat) + '원';

            const elKpi2Val = document.getElementById('kpi2-value');
            const elKpi2Share = document.getElementById('kpi2-share-badge');
            const elKpi3Val = document.getElementById('kpi3-value');
            const elKpi3Share = document.getElementById('kpi3-share-badge');
            if (elKpi2Val) elKpi2Val.textContent = fmtNum(barogaVal) + '원';
            if (elKpi2Share) elKpi2Share.textContent = `비중 ${TOTALS.baroga_share_pct}%`;
            if (elKpi3Val) elKpi3Val.textContent = fmtNum(deodareunVal) + '원';
            if (elKpi3Share) elKpi3Share.textContent = `비중 ${TOTALS.deodareun_share_pct}%`;

            const elKpi4CommTitle = document.getElementById('kpi4-comm-title');
            const elKpi4CommVal = document.getElementById('kpi4-comm-total');
            const elKpi4TaxSub = document.getElementById('kpi4-comm-tax-sub');
            const elKpi4ExemptSub = document.getElementById('kpi4-comm-exempt-sub');
            if (elKpi4CommTitle) elKpi4CommTitle.textContent = `판매수수료 과세 (${label})`;
            if (elKpi4CommVal) elKpi4CommVal.textContent = fmtNum(TOTALS['comm_tax_' + currentMetric]) + '원';
            if (elKpi4TaxSub) elKpi4TaxSub.textContent = fmtNum(TOTALS['comm_tax_' + currentMetric]) + '원';
            if (elKpi4ExemptSub) elKpi4ExemptSub.textContent = fmtNum(TOTALS['comm_exempt_' + currentMetric]) + '원';

            // KPI 5: Franchise Grand Total & #1 Store
            const elKpi4Title = document.getElementById('kpi4-title');
            const elKpi4Val = document.getElementById('kpi4-value');
            const elKpi5Max = document.getElementById('kpi5-max');
            const elKpi5Min = document.getElementById('kpi5-min');
            const elKpi5Cnt = document.getElementById('kpi5-store-cnt');
            const elHeaderFran = document.getElementById('header-franchise-summary');

            if (elKpi4Title) elKpi4Title.textContent = `가맹점 총 매출 (${label})`;

            if (FRANCHISE_DATA.length > 0) {
                const storeCnt = FRANCHISE_DATA.length;
                if (elKpi5Cnt) elKpi5Cnt.textContent = `${storeCnt}개 가맹점 (1~10월 확정)`;
                if (elHeaderFran) elHeaderFran.textContent = `전체 ${storeCnt}개 가맹점 (누적 ${fmtNum(FRANCHISE_GRAND_TOTALS[currentMetric])}원)`;

                const franGrand = FRANCHISE_GRAND_TOTALS[currentMetric];
                const sortedFran = getSortedFranchiseData();
                const top1Store = sortedFran[0];
                const top5Sum = sortedFran.slice(0, 5).reduce((acc, s) => acc + s[currentMetric], 0);
                const top5Share = franGrand > 0 ? ((top5Sum / franGrand) * 100).toFixed(2) : '0.00';

                if (elKpi4Val) elKpi4Val.textContent = fmtNum(franGrand) + '원';
                if (elKpi5Max && top1Store) elKpi5Max.textContent = `${top1Store.name.replace('곤트란쉐리에 ', '')} (${fmtNum(top1Store[currentMetric])}원)`;
                if (elKpi5Min) elKpi5Min.textContent = `전체 매출의 ${top5Share}%`;
            } else {
                if (elKpi4Val) elKpi4Val.textContent = '엑셀 업로드 대기';
                if (elKpi5Max) elKpi5Max.textContent = '하단 버튼에서 파일 선택';
                if (elKpi5Min) elKpi5Min.textContent = '-';
            }

            const elDoughnutBg = document.getElementById('doughnut-baroga-amt');
            const elDoughnutDd = document.getElementById('doughnut-deodareun-amt');
            if (elDoughnutBg) elDoughnutBg.textContent = fmtNum(barogaVal) + '원';
            if (elDoughnutDd) elDoughnutDd.textContent = fmtNum(deodareunVal) + '원';
        }

        // =========================================================================
        // FRANCHISE REVENUE FUNCTIONS: 내림차순 랭킹, 월별 추이 그래프 & 매트릭스 테이블
        // =========================================================================
        function getSortedFranchiseData() {
            return [...FRANCHISE_DATA].sort((a, b) => b[currentMetric] - a[currentMetric]);
        }

        function populateFranchiseSelectOptions() {
            const sel = document.getElementById('franchise-single-select');
            if (!sel) return;
            const sorted = getSortedFranchiseData();
            const baseOptions = `
                <option value="top5">그룹 보기: 매출 상위 1~5 가맹점</option>
                <option value="top6_10">그룹 보기: 매출 상위 6~10 가맹점</option>
                <option value="top11_15">그룹 보기: 매출 상위 11~15 가맹점</option>
                <option value="total_all">전체 가맹점 월별 총매출 추이</option>
            `;
            const storeOptions = sorted.map((s, idx) => {
                return `<option value="${s.code}">개별 가맹점 [${idx + 1}]: ${s.name} (${fmtNum(s.total)}원)</option>`;
            }).join('');
            sel.innerHTML = baseOptions + `<optgroup label="개별 가맹점 선택 (총 사용금액 내림차순)">${storeOptions}</optgroup>`;
            sel.value = currentFranchiseTrendGroup;
        }

        function renderFranchiseTop5Cards() {
            const container = document.getElementById('franchise-top5-cards');
            if (!container) return;
            const sorted = getSortedFranchiseData();
            const grand = FRANCHISE_GRAND_TOTALS[currentMetric];
            const metricLabels = { total: '총 사용금액(합계)', supply: '공급가액', vat: '부가세액' };
            const badgeColors = [
                'border-l-rose-600 bg-rose-50 text-rose-700 border-rose-200',
                'border-l-indigo-600 bg-indigo-50 text-indigo-700 border-indigo-200',
                'border-l-blue-600 bg-blue-50 text-blue-700 border-blue-200',
                'border-l-emerald-600 bg-emerald-50 text-emerald-700 border-emerald-200',
                'border-l-amber-500 bg-amber-50 text-amber-800 border-amber-200'
            ];

            let cumPct = 0;
            container.innerHTML = sorted.slice(0, 5).map((s, idx) => {
                const val = s[currentMetric];
                const share = grand > 0 ? (val / grand) * 100 : 0;
                cumPct += share;
                const mArr = s['m_' + currentMetric];
                const activeMonths = mArr.filter(v => v > 0).length || 1;
                const maxVal = Math.max(...mArr);
                const maxMonthIdx = mArr.indexOf(maxVal) + 1;
                const borderLeftClass = badgeColors[idx].split(' ')[0];

                return `
                    <div onclick="setFranchiseTrendGroup('${s.code}')" class="cursor-pointer bg-white hover:bg-slate-50 transition rounded-2xl p-3.5 shadow-sm border-l-4 ${borderLeftClass} border border-slate-200/80">
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 text-[11px] font-extrabold rounded-md bg-slate-900 text-white whitespace-nowrap">순위 ${idx + 1}</span>
                            <span class="text-[11px] font-bold text-rose-600 whitespace-nowrap">기여도 ${share.toFixed(2)}%</span>
                        </div>
                        <div class="mt-1.5 font-extrabold text-slate-900 text-sm truncate" title="${s.name}">${s.name}</div>
                        <div class="mt-1 text-lg font-extrabold text-slate-900 tracking-tight">${fmtNum(val)}원</div>
                        <div class="mt-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500 flex flex-col gap-0.5">
                            <div class="flex justify-between"><span>실거래 월평균(${activeMonths}개월):</span><strong class="text-slate-700">${fmtNum(val / activeMonths)}원</strong></div>
                            <div class="flex justify-between"><span>최고 매출월(${maxMonthIdx}월):</span><strong class="text-indigo-700">${fmtNum(maxVal)}원</strong></div>
                        </div>
                    </div>
                `;
            }).join('');

            // Update Pareto Summary Boxes
            const top5Sum = sorted.slice(0, 5).reduce((a, b) => a + b[currentMetric], 0);
            const top10Sum = sorted.slice(0, 10).reduce((a, b) => a + b[currentMetric], 0);
            const top20Sum = sorted.slice(0, 20).reduce((a, b) => a + b[currentMetric], 0);

            const elP5 = document.getElementById('pareto-top5-pct');
            const elP10 = document.getElementById('pareto-top10-pct');
            const elP20 = document.getElementById('pareto-top20-pct');
            if (elP5) elP5.textContent = `${((top5Sum / grand) * 100).toFixed(2)}% (${fmtEok(top5Sum)})`;
            if (elP10) elP10.textContent = `${((top10Sum / grand) * 100).toFixed(2)}% (${fmtEok(top10Sum)})`;
            if (elP20) elP20.textContent = `${((top20Sum / grand) * 100).toFixed(2)}% (${fmtEok(top20Sum)})`;
        }

        function setFranchiseRankCount(cnt) {
            currentFranchiseRankCount = cnt;
            [10, 20, 999].forEach(n => {
                const btn = document.getElementById('rank-cnt-' + n);
                if (!btn) return;
                if (n === cnt) {
                    btn.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-600 text-white shadow-sm transition";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition";
                }
            });
            renderFranchiseRankChart();
        }

        function renderFranchiseRankChart() {
            if (FRANCHISE_DATA.length === 0) return;
            const canvas = document.getElementById('franchiseRankChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (franchiseRankChartInstance) {
                franchiseRankChartInstance.destroy();
            }

            const sorted = getSortedFranchiseData();
            const sliced = sorted.slice(0, currentFranchiseRankCount);
            const grand = FRANCHISE_GRAND_TOTALS[currentMetric];
            const metricLabels = { total: '총 사용금액(합계)', supply: '공급가액', vat: '부가세액' };

            const titleEl = document.getElementById('franchise-rank-chart-title');
            if (titleEl) {
                titleEl.textContent = `가맹점별 ${metricLabels[currentMetric]} 내림차순 순위 (상위 ${sliced.length}개점)`;
            }

            const labels = sliced.map((s, idx) => `${idx + 1}. ${s.name.replace('곤트란쉐리에 ', '')}`);
            const values = sliced.map(s => s[currentMetric]);
            const bgColors = sliced.map((_, idx) => {
                if (idx === 0) return 'rgba(225, 29, 72, 0.92)';
                if (idx < 3) return 'rgba(244, 63, 94, 0.85)';
                if (idx < 5) return 'rgba(79, 70, 229, 0.85)';
                if (idx < 10) return 'rgba(37, 99, 235, 0.80)';
                return 'rgba(100, 116, 139, 0.75)';
            });

            franchiseRankChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: `1~10월 누적 ${metricLabels[currentMetric]}`,
                        data: values,
                        backgroundColor: bgColors,
                        borderRadius: 4,
                        barPercentage: 0.8
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    onClick: (evt, elements) => {
                        if (elements && elements.length > 0) {
                            const idx = elements[0].index;
                            const store = sliced[idx];
                            if (store) {
                                setFranchiseTrendGroup(store.code);
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    const val = context.parsed.x;
                                    const share = grand > 0 ? ((val / grand) * 100).toFixed(2) : '0.00';
                                    return ` 누적 금액: ${fmtKRW(val)} (본사 매출 기여도 ${share}%)`;
                                },
                                footer: function(items) {
                                    const idx = items[0].dataIndex;
                                    let cum = 0;
                                    for (let i = 0; i <= idx; i++) cum += sliced[i][currentMetric];
                                    const cumPct = grand > 0 ? ((cum / grand) * 100).toFixed(2) : '0.00';
                                    return `1~${idx + 1} 누적 점유율: ${cumPct}% (클릭 시 우측 월별 추이 표시)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { callback: v => fmtEok(v), font: { size: 11 } }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { family: 'Pretendard', size: currentFranchiseRankCount > 25 ? 9.5 : 11, weight: '600' } }
                        }
                    }
                }
            });
        }

        function setFranchiseTrendGroup(groupOrCode) {
            currentFranchiseTrendGroup = groupOrCode;
            ['top5', 'top6_10', 'top11_15', 'total_all'].forEach(g => {
                const btn = document.getElementById('fgroup-' + g);
                if (!btn) return;
                if (g === groupOrCode) {
                    btn.className = "px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white shadow-sm transition";
                } else {
                    btn.className = "px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:text-slate-900 transition";
                }
            });
            const sel = document.getElementById('franchise-single-select');
            if (sel && sel.value !== groupOrCode) {
                sel.value = groupOrCode;
            }
            renderFranchiseTrendChart();
        }

        function renderFranchiseTrendChart() {
            if (FRANCHISE_DATA.length === 0) return;
            const canvas = document.getElementById('franchiseTrendChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (franchiseTrendChartInstance) {
                franchiseTrendChartInstance.destroy();
            }

            const labels = ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월'];
            const sorted = getSortedFranchiseData();
            const palette = ['#e11d48', '#2563eb', '#10b981', '#f59e0b', '#9333ea'];
            const metricLabels = { total: '총 사용금액(합계)', supply: '공급가액', vat: '부가세액' };
            const mKey = 'm_' + currentMetric;

            let datasets = [];
            let chartTitle = `가맹점별 월별 매출 마감 추이 (${metricLabels[currentMetric]})`;

            if (currentFranchiseTrendGroup === 'top5') {
                chartTitle = `매출 기여도 상위 1~5 가맹점 월별 매출 추이 (${metricLabels[currentMetric]})`;
                datasets = sorted.slice(0, 5).map((s, i) => ({
                    label: `${i + 1}. ${s.name.replace('곤트란쉐리에 ', '')}`,
                    data: s[mKey],
                    borderColor: palette[i % palette.length],
                    backgroundColor: palette[i % palette.length],
                    borderWidth: 2.5,
                    pointRadius: 3.5,
                    tension: 0.25,
                    fill: false
                }));
            } else if (currentFranchiseTrendGroup === 'top6_10') {
                chartTitle = `매출 기여도 상위 6~10 가맹점 월별 매출 추이 (${metricLabels[currentMetric]})`;
                datasets = sorted.slice(5, 10).map((s, i) => ({
                    label: `${i + 6}. ${s.name.replace('곤트란쉐리에 ', '')}`,
                    data: s[mKey],
                    borderColor: palette[i % palette.length],
                    backgroundColor: palette[i % palette.length],
                    borderWidth: 2.5,
                    pointRadius: 3.5,
                    tension: 0.25,
                    fill: false
                }));
            } else if (currentFranchiseTrendGroup === 'top11_15') {
                chartTitle = `매출 기여도 상위 11~15 가맹점 월별 매출 추이 (${metricLabels[currentMetric]})`;
                datasets = sorted.slice(10, 15).map((s, i) => ({
                    label: `${i + 11}. ${s.name.replace('곤트란쉐리에 ', '')}`,
                    data: s[mKey],
                    borderColor: palette[i % palette.length],
                    backgroundColor: palette[i % palette.length],
                    borderWidth: 2.5,
                    pointRadius: 3.5,
                    tension: 0.25,
                    fill: false
                }));
            } else if (currentFranchiseTrendGroup === 'total_all') {
                chartTitle = `전체 가맹점 월별 총 매출 마감 추이 (${metricLabels[currentMetric]})`;
                datasets = [{
                    label: `전체 가맹점 월별 ${metricLabels[currentMetric]}`,
                    data: FRANCHISE_MONTHLY_TOTALS[currentMetric],
                    borderColor: '#e11d48',
                    backgroundColor: 'rgba(225, 29, 72, 0.14)',
                    borderWidth: 3,
                    pointRadius: 5,
                    tension: 0.25,
                    fill: true
                }];
            } else {
                const targetIdx = sorted.findIndex(s => s.code === currentFranchiseTrendGroup);
                const store = targetIdx >= 0 ? sorted[targetIdx] : sorted[0];
                const rank = targetIdx >= 0 ? targetIdx + 1 : 1;
                const storeCnt = FRANCHISE_DATA.filter(s => s.total > 0).length || 1;
                chartTitle = `[순위 ${rank}] ${store.name} 월별 매출 마감 추이 (${metricLabels[currentMetric]})`;
                const avgLine = FRANCHISE_MONTHLY_TOTALS[currentMetric].map(v => Math.round(v / storeCnt));
                datasets = [
                    {
                        label: `${store.name} (#${rank})`,
                        data: store[mKey],
                        borderColor: '#e11d48',
                        backgroundColor: 'rgba(225, 29, 72, 0.15)',
                        borderWidth: 3,
                        pointRadius: 5,
                        tension: 0.25,
                        fill: true
                    },
                    {
                        label: `${storeCnt}개 가맹점 전체 월평균선`,
                        data: avgLine,
                        borderColor: '#64748b',
                        borderDash: [6, 4],
                        borderWidth: 2,
                        pointRadius: 2,
                        tension: 0.2,
                        fill: false
                    }
                ];
            }

            const titleEl = document.getElementById('franchise-trend-chart-title');
            if (titleEl) titleEl.textContent = chartTitle;

            franchiseTrendChartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Pretendard', size: 11.5, weight: '600' } } },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            padding: 12,
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${fmtKRW(ctx.parsed.y)}`
                            }
                        }
