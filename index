        // 3. Build 100% Clean, Self-Contained Standalone HTML String (Strips Tailwind runtime bloat & embeds latest uploaded data)
        function getCleanStandaloneHTMLString() {
            const cloneDoc = document.documentElement.cloneNode(true);

            // 1. Remove dynamically injected Tailwind JIT <style> tags in <head> (keep only our first custom <style> tag)
            const headStyles = Array.from(cloneDoc.querySelectorAll('head style'));
            headStyles.forEach((st, idx) => {
                if (idx > 0) st.remove();
            });

            // 2. Ensure Notion & GAS modals and extraction button are stripped/closed in exported standalone HTML
            const cloneGasBtn = cloneDoc.querySelector('#btn-open-gas-modal');
            if (cloneGasBtn) cloneGasBtn.remove();
            const cloneGasModal = cloneDoc.querySelector('#gas-modal');
            if (cloneGasModal) cloneGasModal.remove();
            const cloneModal = cloneDoc.querySelector('#notion-modal');
            if (cloneModal) {
                cloneModal.remove();
            }
            const cloneBody = cloneDoc.querySelector('body');
            if (cloneBody) {
                cloneBody.classList.remove('pdf-exporting');
            }

            // 3. Clear Chart.js inline attributes on cloned canvases so Chart.js freshly initializes when opened
            cloneDoc.querySelectorAll('canvas').forEach(c => {
                c.removeAttribute('style');
                c.removeAttribute('width');
                c.removeAttribute('height');
            });

            // 4. Clear pre-populated tbody/tfoot so DOMContentLoaded renders them cleanly without duplication
            ['monthly-ledger-tbody', 'monthly-ledger-tfoot', 'commission-ledger-tbody', 'commission-ledger-tfoot', 'franchise-matrix-tbody', 'franchise-matrix-tfoot', 'franchise-top5-cards'].forEach(id => {
                const el = cloneDoc.querySelector('#' + id);
                if (el) el.innerHTML = '';
            });

            // 5. If user uploaded 11·12월 Excel files, bake the updated MONTHLY_DATA & FRANCHISE_DATA directly into the exported script
            const scriptEl = cloneDoc.querySelector('#dashboard-main-script');
            if (scriptEl) {
                let code = scriptEl.textContent;
                code = code.replace(
                    /const MONTHLY_DATA = \[[\s\S]*?\];/,
                    `const MONTHLY_DATA = ${JSON.stringify(MONTHLY_DATA, null, 4)};`
                );
                code = code.replace(
                    /const TOTALS = \{[\s\S]*?\};/,
                    `const TOTALS = ${JSON.stringify(TOTALS, null, 4)};`
                );
                scriptEl.textContent = code;
            }

            return '<!DOCTYPE html>\n' + cloneDoc.outerHTML;
        }

