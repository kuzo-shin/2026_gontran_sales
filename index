                    <div class="flex items-center gap-2 shrink-0">
                        <button onclick="copyLoadedFranchiseJSON()" class="px-4 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs sm:text-sm shadow-lg transition flex items-center gap-2">
