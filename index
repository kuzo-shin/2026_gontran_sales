        // Direct 1-Click PDF Export Function (Full Dashboard + All 57 Stores Unrolled)
        async function exportPDF() {
            const btn = document.getElementById('btn-export-pdf');
            const btnText = document.getElementById('btn-export-pdf-text');
            if (btn) btn.disabled = true;
            if (btnText) btnText.textContent = 'PDF 생성 중...';

            // Store references to swapped canvases and temporarily detached hidden elements
            const canvasSwaps = [];
            const hiddenRestores = [];

            try {
                // 1. Temporarily remove any hidden tab sections from DOM so 0x0 canvases inside them cannot trigger drawImage errors
                ['tab-overview', 'tab-commission', 'tab-franchise', 'tab-quarter', 'franchise-empty-guide'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el && (el.classList.contains('hidden') || window.getComputedStyle(el).display === 'none')) {
                        const parent = el.parentNode;
                        const next = el.nextSibling;
                        hiddenRestores.push({ el, parent, next });
                        parent.removeChild(el);
                    }
                });

                // 2. Convert all visible Chart.js <canvas> elements into static <img> snapshots
                //    This completely prevents html2canvas from calling drawImage on a 0-width/0-height canvas
                const canvases = Array.from(document.querySelectorAll('#dashboard-pdf-root canvas'));
                canvases.forEach(canvas => {
                    const rect = canvas.getBoundingClientRect();
                    if (canvas.width > 0 && canvas.height > 0 && rect.width > 0 && rect.height > 0) {
                        try {
                            const dataUrl = canvas.toDataURL('image/png', 1.0);
                            const img = document.createElement('img');
                            img.src = dataUrl;
                            img.style.width = rect.width + 'px';
                            img.style.height = rect.height + 'px';
                            img.style.display = 'block';
                            img.style.margin = '0 auto';
                            const parent = canvas.parentNode;
                            parent.insertBefore(img, canvas);
                            canvas.style.display = 'none';
                            canvasSwaps.push({ canvas, img });
                        } catch (e) {
                            console.warn('Canvas snapshot skipped:', e);
                        }
                    } else {
                        // Hide any 0-dimension canvas completely
                        const parent = canvas.parentNode;
                        const next = canvas.nextSibling;
                        hiddenRestores.push({ el: canvas, parent, next });
                        parent.removeChild(canvas);
                    }
                });

                // 3. Expand scrollable tables & hide no-print controls
                document.body.classList.add('pdf-exporting');

                // Wait a frame for images and layout to settle
                await new Promise(resolve => setTimeout(resolve, 150));

                const element = document.getElementById('dashboard-pdf-root');
                const opt = {
                    margin:       [6, 6, 6, 6],
                    filename:     '2026년_1월-10월_재무마감_및_가맹점매출_통합대시보드.pdf',
                    image:        { type: 'jpeg', quality: 0.96 },
                    html2canvas:  {
                        scale: 1.25,
                        useCORS: true,
                        logging: false,
                        scrollX: 0,
                        scrollY: 0,
                        backgroundColor: '#ffffff'
                    },
                    jsPDF:        { unit: 'mm', format: 'a3', orientation: 'landscape' },
                    pagebreak:    { mode: ['css', 'legacy'] }
                };

                await html2pdf().set(opt).from(element).save();
            } catch (err) {
                console.error('PDF generation fallback to print:', err);
                window.print();
            } finally {
                // Restore swapped canvases
                canvasSwaps.forEach(({ canvas, img }) => {
                    canvas.style.display = '';
                    if (img.parentNode) img.parentNode.removeChild(img);
                });

                // Restore removed hidden elements in reverse order
                for (let i = hiddenRestores.length - 1; i >= 0; i--) {
                    const { el, parent, next } = hiddenRestores[i];
                    if (parent) {
                        parent.insertBefore(el, next);
                    }
                }

                document.body.classList.remove('pdf-exporting');
                if (btn) btn.disabled = false;
                if (btnText) btnText.textContent = 'PDF 다운로드';
            }
        }

