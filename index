        function exportFranchiseCSV() {
            const sorted = getSortedFranchiseData();
            const grand = FRANCHISE_GRAND_TOTALS[currentMetric];
            const mKey = 'm_' + currentMetric;
            const headers = [
                "순위", "가맹점명", "1~10월_누적총액", "매출기여도(%)", "누적점유율(%)",
                "1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "실거래_월평균"
            ];

            let cum = 0;
            const rows = sorted.map((s, idx) => {
                const val = s[currentMetric];
                cum += val;
                const share = grand > 0 ? ((val / grand) * 100).toFixed(2) : '0.00';
                const cumPct = grand > 0 ? ((cum / grand) * 100).toFixed(2) : '0.00';
                const mArr = s[mKey];
                const activeCnt = mArr.filter(v => v > 0).length || 1;
                return [
                    idx + 1, s.name, val, share, cumPct,
                    ...mArr, Math.round(val / activeCnt)
                ];
            });

            rows.push([
                "합계", "전체 39개 가맹점", grand, "100.00", "100.00",
                ...FRANCHISE_MONTHLY_TOTALS[currentMetric], Math.round(grand / 10)
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", "2026년_1월-10월_가맹점별_매출마감_순위_및_월별추이.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

