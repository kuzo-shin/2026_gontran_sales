                    if (!detectedDate && colDate !== -1 && row[colDate]) {
                        detectedDate = String(row[colDate]).trim();
                    }

                    if (rawName.includes('바로가')) {
                        b_sup += sVal; b_vat += vVal; b_tot += tVal;
