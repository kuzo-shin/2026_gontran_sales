            renderFranchiseTrendChart();
            renderFranchiseTable();
        }

        // Copy currently loaded 1~10M franchise JSON to clipboard so user can paste it in chat for permanent code embedding
        function copyLoadedFranchiseJSON() {
            const payload = JSON.stringify({
                stores: FRANCHISE_DATA,
                monthlyTotals: FRANCHISE_MONTHLY_TOTALS,
                grandTotals: FRANCHISE_GRAND_TOTALS
            });
            const ta = document.createElement('textarea');
            ta.value = payload;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);

            const btn = document.getElementById('btn-copy-franchise-json');
            if (btn) {
                const orig = btn.innerHTML;
                btn.innerHTML = `<i class="fa-solid fa-check"></i><span>복사 완료! 채팅창에 붙여넣어 주세요</span>`;
                setTimeout(() => { btn.innerHTML = orig; }, 3500);
            }
        }

